{
  "datasets": [
    {
      "name": "ds_acciones",
      "displayName": "Acciones por turno",
      "queryLines": [
        "-- `expected_action` solo lo escribe el harness de evaluación: con valor es un caso de eval, sin\n",
        "-- valor es tráfico real. El eval tiene casos de abstención a propósito, así que mezclarlos\n",
        "-- distorsiona la foto de la operación (revisión de servicio en el #75).\n",
        "SELECT CASE WHEN expected_action IS NULL THEN 'operación' ELSE 'evaluación' END AS origen,\n",
        "       action,\n",
        "       count(*)                                        AS turnos,\n",
        "       round(avg(latency_ms))                          AS latencia_media_ms,\n",
        "       round(avg(groundedness), 3)                     AS groundedness\n",
        "FROM hackathon.ops.agent_turns\n",
        "GROUP BY 1, action\n",
        "ORDER BY origen, turnos DESC"
      ]
    },
    {
      "name": "ds_escalamientos",
      "displayName": "Por qué escala el agente",
      "queryLines": [
        "-- ADR-21 §3: separa la abstención correcta (policy, scope) del fallo de infraestructura\n",
        "-- (timeout_tool). Sin esta columna, la matriz de confusión de acción mezclaría las dos.\n",
        "SELECT CASE WHEN expected_action IS NULL THEN 'operación' ELSE 'evaluación' END AS origen,\n",
        "       escalate_reason,\n",
        "       count(*)                                                    AS escalamientos,\n",
        "       CASE WHEN escalate_reason = 'timeout_tool' THEN 'infraestructura'\n",
        "            ELSE 'decisión del agente' END                         AS naturaleza\n",
        "FROM hackathon.ops.agent_turns\n",
        "WHERE action = 'escalate'\n",
        "GROUP BY 1, escalate_reason\n",
        "ORDER BY origen, escalamientos DESC"
      ]
    },
    {
      "name": "ds_latencia",
      "displayName": "Latencia por acción",
      "queryLines": [
        "SELECT action,\n",
        "       round(percentile(latency_ms, 0.50)) AS p50_ms,\n",
        "       round(percentile(latency_ms, 0.95)) AS p95_ms,\n",
        "       count(*)                            AS turnos\n",
        "FROM hackathon.ops.agent_turns\n",
        "GROUP BY action\n",
        "ORDER BY p95_ms DESC"
      ]
    },
    {
      "name": "ds_idioma",
      "displayName": "Turnos por idioma",
      "queryLines": [
        "SELECT CASE WHEN locale LIKE 'pt%' THEN 'pt' ELSE 'es' END AS idioma,\n",
        "       count(*)                                            AS turnos,\n",
        "       round(avg(groundedness), 3)                         AS groundedness,\n",
        "       round(avg(latency_ms))                              AS latencia_media_ms\n",
        "FROM hackathon.ops.agent_turns\n",
        "GROUP BY 1\n",
        "ORDER BY turnos DESC"
      ]
    },
    {
      "name": "ds_costo",
      "displayName": "Costo y volumen",
      "queryLines": [
        "SELECT count(*)                                   AS turnos,\n",
        "       round(sum(cost_usd), 4)                     AS costo_total_usd,\n",
        "       round(avg(cost_usd), 6)                     AS costo_por_turno_usd,\n",
        "       sum(tokens_in + tokens_out)                 AS tokens\n",
        "FROM hackathon.ops.agent_turns"
      ]
    },
    {
      "name": "ds_dq_resumen",
      "displayName": "Calidad por capa",
      "queryLines": [
        "SELECT split(table, '[.]')[0]                              AS capa,\n",
        "       count(*)                                            AS checks,\n",
        "       sum(CASE WHEN passed THEN 0 ELSE 1 END)             AS fallidos\n",
        "FROM hackathon.ops.dq_results\n",
        "WHERE run_ts = (SELECT max(run_ts) FROM hackathon.ops.dq_results)\n",
        "GROUP BY 1\n",
        "ORDER BY capa"
      ]
    },
    {
      "name": "ds_motivos",
      "displayName": "Peso de cada motivo de contacto",
      "queryLines": [
        "-- Confirma el 22 % de Producto y da el contexto: el FCR es lo que separa lo automatizable\n",
        "-- (Producto 0,896) de lo que necesita una persona (Queja 0,436).\n",
        "SELECT reason_category,\n",
        "       sum(volume)                                            AS contactos,\n",
        "       round(100 * sum(volume) / sum(sum(volume)) OVER (), 1) AS pct_total,\n",
        "       round(sum(fcr_rate * volume) / sum(volume), 3)         AS fcr,\n",
        "       round(sum(escalated) / sum(volume), 3)                 AS tasa_escalado\n",
        "FROM hackathon.gold.contact_demand\n",
        "GROUP BY reason_category\n",
        "ORDER BY contactos DESC"
      ]
    },
    {
      "name": "ds_producto_pais",
      "displayName": "Consultas de producto por país",
      "queryLines": [
        "SELECT country,\n",
        "       sum(volume)                                            AS contactos_producto,\n",
        "       round(100 * sum(volume) / sum(sum(volume)) OVER (), 1) AS pct_del_total_producto,\n",
        "       round(avg(wait_p50_s))                                 AS espera_p50_s\n",
        "FROM hackathon.gold.contact_demand\n",
        "WHERE reason_category = 'Producto'\n",
        "GROUP BY country\n",
        "ORDER BY contactos_producto DESC"
      ]
    },
    {
      "name": "ds_periodo",
      "displayName": "Periodo y volumen diario",
      "queryLines": [
        "SELECT min(date) AS desde, max(date) AS hasta,\n",
        "       round(sum(volume) / count(DISTINCT date)) AS contactos_por_dia\n",
        "FROM hackathon.gold.contact_demand\n",
        "WHERE reason_category = 'Producto'"
      ]
    }
  ],
