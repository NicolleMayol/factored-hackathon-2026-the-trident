# Copia a .env (ignorado por git). Nombres = contracts/infra.yaml. mock|real por dependencia (ADR-21).
AGENT_LLM=mock
AGENT_STORE=mock
AGENT_SQL=mock
AGENT_PRESCORE=mock
AGENT_EMBED=mock
AGENT_TRACE=mock
JWT_SIGNING_KEY=local-dev-key-change-me
# local: perfil OAuth de la CLI (sin tokens): databricks auth login --host https://adb-xxxx.azuredatabricks.net --profile fh26
DATABRICKS_CONFIG_PROFILE=fh26
# DATABRICKS_HOST es opcional en local (lo da el perfil); obligatorio en Azure
DATABRICKS_HOST=
# Azure: la Function usa sp-agent-ro (OAuth M2M); valores en Key Vault, nunca aquí
DATABRICKS_CLIENT_ID=
DATABRICKS_CLIENT_SECRET=
SQL_HTTP_PATH=
FM_ENDPOINT_MAIN=databricks-meta-llama-3-3-70b-instruct
FM_ENDPOINT_SMALL=databricks-meta-llama-3-1-8b-instruct
PRESCORE_ENDPOINT=prescore-lgbm
EMBED_ENDPOINT=embed-bge-m3
COSMOS_ENDPOINT=
COSMOS_KEY=
MLFLOW_TRACKING_URI=databricks
MLFLOW_EXPERIMENT=/Shared/fh26/agente
# solo para scripts/check_access.py A7
FUNCTION_URL=
